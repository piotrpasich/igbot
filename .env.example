# Copy to .env and adjust as needed. All variables are optional.

# Path to the yt-dlp executable. Defaults to the bundled ./bin/yt-dlp
# (downloaded automatically via `npm install`), falling back to `yt-dlp`
# on PATH if that's not present.
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Path to the ffmpeg executable, passed to yt-dlp via --ffmpeg-location.
# Defaults to the bundled ./bin/ffmpeg (downloaded automatically via
# `npm install`), falling back to `ffmpeg` on PATH if that's not present.
# yt-dlp needs ffmpeg to mux separate video+audio streams into one file —
# without it, posts that don't expose an already-muxed format will fail to
# download even though metadata probing succeeds.
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Netscape-format cookies file used by default for authenticated content
# (e.g. Instagram posts that require login). Can be overridden per-request
# via the CLI --cookies flag or the API `cookies` parameter.
# YTDLP_COOKIES_FILE=./cookies.txt

# Directory for temporary per-request download folders.
# SLACKGRAM_TMP_DIR=/tmp/slackgram

# TMPDIR passed to the yt-dlp child process only. yt-dlp's standalone binary
# self-extracts its bundled Python runtime here and executes from there;
# some shared hosts mount /tmp `noexec`, which breaks that. Defaults to a
# project-local ./.yt-dlp-tmp directory, which should be exec-allowed on
# most hosts. Override if that's not writable/executable in your setup.
# YTDLP_TMPDIR=/tmp/slackgram-ytdlp-extract

# Max time (ms) allowed for a single extraction before it's aborted.
# SLACKGRAM_TIMEOUT_MS=120000

# Max number of concurrent extraction/download jobs handled by the API.
# SLACKGRAM_MAX_CONCURRENT_JOBS=4

# HTTP port for the API server.
# PORT=3000

# URL path prefix to mount routes under. Needed when deployed behind
# Phusion Passenger with a PassengerBaseURI set (e.g. "/igbot"), since
# Passenger's Node integration does not strip that prefix from incoming
# request paths — leave unset for standalone/dev use or reverse proxies
# that do strip it themselves.
# BASE_PATH=/igbot
